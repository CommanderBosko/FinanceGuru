__pycache__/
*.pyc
*.pyo
.pytest_cache/
dist/
build/
*.egg-info/
result
result-*

# Local Flatpak build/test artifacts (flatpak-builder, exported repo, bundle)
.flatpak-builder/
build-dir/
repo/
*.flatpak

# PyInstaller build output (Windows/macOS packaging; dist/ and build/ are
# already ignored above)
packaging/pyinstaller/build-assets/

# Never commit the financial database (lives in ~/.local/share by default,
# but guard against accidental copies into the tree)
*.db
*.sqlite
*.sqlite3

# Claude Code: personal, machine-specific permission overrides.
# .claude/settings.json and .claude/skills/ ARE tracked (shared project
# conventions); this file is per-contributor and should never be shared.
.claude/settings.local.json
